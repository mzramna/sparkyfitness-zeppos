{
  "configVersion": "v3",
  "app": {
    "appId": 1099001,
    "appName": "SparkyFitness",
    "appType": "app",
    "version": { "code": 1, "name": "0.1.0" },
    "icon": "icon.png",
    "vender": "mzramna",
    "description": "Registro de água, remédios, ciclo e alimentação com sync para SparkyFitness"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": { "apiVersion": { "compatible": "3.0.0", "target": "3.0.0", "minVersion": "3.0.0" } },
  "targets": {
    "default": {
      "module": {
        "page": { "pages": ["page/index", "page/list"] },
        "app-side": { "path": "app-side/index" },
        "setting": { "path": "setting/index" }
      },
      "platforms": [{ "st": "r" }, { "st": "s" }],
      "designWidth": 480
    }
  },
  "i18n": { "pt-BR": { "appName": "SparkyFitness" }, "en-US": { "appName": "SparkyFitness" } },
  "defaultLanguage": "pt-BR"
}
